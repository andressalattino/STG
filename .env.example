# Copiar las variables necesarias a .env.local. Nunca subir ese archivo a Git.
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="TU-CLAVE-PUBLICABLE"

# Supabase > Connect > Session pooler. Contraseña de la BASE, codificada para URL.
# Copiar host, usuario y puerto exactamente desde el panel; no inferir la región.
DATABASE_URL="postgresql://postgres.TU-PROYECTO:CONTRASENA@HOST-DEL-POOLER:5432/postgres"

# Opcional en desarrollo; requerido para enlaces de recibos compartidos.
# Debe ser el dominio HTTPS real donde esté publicada esta aplicación.
NEXT_PUBLIC_SITE_URL=""
